#!name=YouTube Enhance
#!desc=YouTube / YouTube Music 去广告与后台播放；UMP Worker 可选
#!author=Based on Maasea/sgmodule and community Shadowrocket rules
#!homepage=https://github.com/Maasea/sgmodule
#!version=2026.11.18.3
#!arguments=EnableUMPWorker:true
#!arguments-desc=EnableUMPWorker: true 启用新式 UMP/Onesie 请求处理（可能经第三方 Worker）；false 停用这两条请求脚本，保留其他去广告功能。

# --- Module ---
# name/desc：模块显示名和功能摘要；author/homepage：脚本来源及项目地址。
# version：本模块配置版本；arguments/arguments-desc：可编辑的开关及其说明。
# 使用要求：启用 HTTPS 解密并信任本机 CA；不要叠加其他 YouTube 响应修改模块。

[Rule]
# --- UDP Fallback ---
# AND / googlevideo.com：同时匹配视频域名和 UDP 时拒绝，促使请求回落 TCP。
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
# AND / youtubei.googleapis.com：同时匹配 API 主机和 UDP 时拒绝，以便 HTTPS 解密。
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[URL Rewrite]
# --- Ad Requests ---
# player/ad_break：对独立中插广告接口返回空的 HTTP 200；异常卡顿时优先排查此项。
^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$ _ reject-200
# googlevideo / oad：拦截旧式广告参数；排除正常播放与新式 initplayback 请求。
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads|videoplayback(?:\?|\/)|initplayback(?:\?|\/)).+[?&]oad(?:[=&]|$) _ reject-200
# api/stats/ads：拦截 YouTube 广告统计请求，不拦截普通播放统计。
^https?:\/\/(?:www|s)\.youtube\.com\/api\/stats\/ads(?:[/?]|$) _ reject-200
# pagead/ptracking：拦截页面广告与播放追踪接口，保留其他路径。
^https?:\/\/(?:www|s)\.youtube\.com\/(?:pagead|ptracking)(?:[/?]|$) _ reject-200
# api/stats/qoe：仅拦截以 adcontext 开头的广告质量统计请求。
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext(?:=|&|$) _ reject-200
# URL Rewrite：前半段为 URL 正则，reject-200 表示以空的 HTTP 200 拒绝匹配请求。

[Script]
# --- Response ---
# youtube.response：type=http-response 处理所列 API 的 Protobuf 响应；pattern 限定接口。
# requires-body=1 读取正文；max-size=-1 不限制正文大小；binary-body-mode=1 使用二进制。
# script-path 追踪 Maasea master；argument 关闭字幕翻译、隐藏按钮及调试等附加功能。
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js,argument="{"captionLang":"off","blockUpload":false,"blockImmersive":false,"blockShorts":false,"debug":false}"

# --- UMP / Onesie Requests ---
# youtube.request.init：type=http-request 处理 initplayback 的加密请求；pattern 限定匹配路径。
# requires-body/max-size/binary-body-mode 同上；script-path 使用 Maasea master 请求脚本。
# argument 关闭字幕翻译；enable 从 EnableUMPWorker 获取开关值，不与旧 Map Local 混用。
youtube.request.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js,argument="{"captionLang":"off"}",enable={{{EnableUMPWorker}}}
# youtube.request.log_event：处理 API 日志请求以配合 UMP 密钥缓存，不拦截日志 URL。
# type/pattern 指明请求与路径；requires-body/max-size/binary-body-mode 设置正文处理方式。
# script-path 指向相同请求脚本；enable 与 initplayback 共用 EnableUMPWorker 开关。
youtube.request.log_event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js,enable={{{EnableUMPWorker}}}

[MITM]
# --- HTTPS Decryption ---
# hostname：%APPEND% 在既有解密主机清单后追加；*.googlevideo.com 覆盖视频子域名。
# youtubei.googleapis.com 与 www/s.youtube.com 用于 API 和广告请求解密。
# -redirector*.googlevideo.com 为排除项；仅对匹配主机启用 HTTPS 解密。
hostname = %APPEND% -redirector*.googlevideo.com, *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, s.youtube.com
