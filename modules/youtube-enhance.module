#!name=YouTube Enhance (Shadowrocket)
#!desc=去广告/画中画/后台播放；隐私优先，不调用第三方 Worker；效果随 YouTube App 版本变化
#!arguments=屏蔽上传按钮:false,屏蔽选段按钮:false,屏蔽Shorts按钮:false,字幕翻译语言:off,启用调试模式:false
#!arguments-desc=屏蔽参数: true/false；翻译语言: off 或语言代码；播放异常时禁用模块并重试。
# v1.0；Maasea 响应脚本（Apache-2.0），锁定版本
# 需启用 HTTPS 解密和信任本机 CA；不加载 request 脚本
# 部分 UMP / 中插广告可能无法去除
[Rule]
# 阻断相关 QUIC，便于 HTTPS 解密
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[URL Rewrite]
# 拒绝部分广告统计请求
^https?://(?:www|s)\.youtube\.com/api/stats/ads(?:[?#]|$) _ reject-200
^https?://(?:www|s)\.youtube\.com/(?:pagead|ptracking)(?:[/?#]|$) _ reject-200
^https?://s\.youtube\.com/api/stats/qoe\?adcontext(?:=|&|$) _ reject-200
# 拦截旧广告资源，保留正常视频流
^https?://[\w-]+\.googlevideo\.com/(?!(?:dclk_video_ads|videoplayback\?)).+&oad(?:[=&]|$) _ reject-200

[Script]
# 上游响应脚本：固定版本
youtube.clean.response = type=http-response,pattern=^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:[?#]|$),requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/65075cdb388fc5e3094afd7e7314c67b243f3525/Script/Youtube/youtube.response.js,argument="{"captionLang":"{{{字幕翻译语言}}}","blockUpload":{{{屏蔽上传按钮}}},"blockImmersive":{{{屏蔽选段按钮}}},"blockShorts":{{{屏蔽Shorts按钮}}},"debug":{{{启用调试模式}}}}"

[MITM]
# YouTube HTTPS 解密域名
hostname = %APPEND% -redirector*.googlevideo.com, *.googlevideo.com, s.youtube.com, www.youtube.com, youtubei.googleapis.com
