#!name=YouTube Enhance
#!desc=YouTube / Music 去广告、画中画、后台播放；UMP Worker 可选
#!arguments=屏蔽上传按钮:false,屏蔽选段按钮:false,屏蔽Shorts按钮:false,字幕翻译语言:off,启用UMP第三方Worker:false,启用调试模式:false
#!arguments-desc=开关 true/false；字幕语言 off 或语言代码；UMP Worker 默认关闭，开启会增加第三方隐私风险。
# Maasea/sgmodule @ 65075cdb388fc5e3094afd7e7314c67b243f3525 (Apache-2.0)
# 需开启 HTTPS 解密；勿与其他 YouTube 模块叠加。

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[URL Rewrite]
# 过滤广告上报与旧式资源，不拦截正常视频请求。
^https?://(?:www|s)\.youtube\.com/api/stats/ads(?:[?#]|$) _ reject-200
^https?://(?:www|s)\.youtube\.com/(?:pagead|ptracking)(?:[/?#]|$) _ reject-200
^https?://s\.youtube\.com/api/stats/qoe\?adcontext(?:=|&|$) _ reject-200
^https?://[\w-]+\.googlevideo\.com/(?!(?:dclk_video_ads|videoplayback\?|initplayback\?)).+&oad(?:[=&]|$) _ reject-200

[Script]
# 广告处理、画中画及后台播放
youtube.clean.response = type=http-response,pattern=^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch|log_event|config)(?:[?#]|$),requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/65075cdb388fc5e3094afd7e7314c67b243f3525/Script/Youtube/youtube.response.js,argument="{"captionLang":"{{{字幕翻译语言}}}","blockUpload":{{{屏蔽上传按钮}}},"blockImmersive":{{{屏蔽选段按钮}}},"blockShorts":{{{屏蔽Shorts按钮}}},"debug":{{{启用调试模式}}}}"

# UMP Worker：默认关闭，开启可能向第三方发送播放密钥信息及目标 URL。
youtube.clean.request.init = type=http-request,pattern=^https?://[\w-]+\.googlevideo\.com/initplayback.+&ack.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/65075cdb388fc5e3094afd7e7314c67b243f3525/Script/Youtube/youtube.request.js,argument="{"captionLang":"{{{字幕翻译语言}}}"}",enable={{{启用UMP第三方Worker}}}
youtube.clean.request.log_event = type=http-request,pattern=^https://youtubei\.googleapis\.com/youtubei/v1/log_event(?:[?#]|$),requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/65075cdb388fc5e3094afd7e7314c67b243f3525/Script/Youtube/youtube.request.js,enable={{{启用UMP第三方Worker}}}

[MITM]
hostname = %APPEND% -redirector*.googlevideo.com, *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, s.youtube.com
