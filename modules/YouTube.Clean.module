#!name=YouTube Clean (Shadowrocket)
#!desc=去广告/画中画/后台播放；隐私优先，不调用第三方 Worker；效果随 YouTube App 版本变化
#!arguments=屏蔽上传按钮:false,屏蔽选段按钮:false,屏蔽Shorts按钮:false,字幕翻译语言:off,启用调试模式:false
#!arguments-desc=屏蔽参数: true/false；翻译语言: off 或语言代码；播放异常时禁用模块并重试。
# YouTube Clean v1.0 (2026-11-16)
# Based on Maasea/sgmodule (Apache-2.0). Vendored response code is unmodified.
# The request script is intentionally absent, so some encrypted UMP ads may remain.
# Do not block player/ad_break until a validated response parser is available.
# HTTPS Decryption and a trusted local CA certificate are required.

[Rule]
# Prevent QUIC bypass of relevant YouTube HTTPS decryption endpoints.
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[URL Rewrite]
# Block known ad reporting paths, not general playback endpoints.
^https?://(?:www|s)\.youtube\.com/api/stats/ads(?:[?#]|$) _ reject-200
^https?://(?:www|s)\.youtube\.com/(?:pagead|ptracking)(?:[/?#]|$) _ reject-200
^https?://s\.youtube\.com/api/stats/qoe\?adcontext(?:=|&|$) _ reject-200
# Legacy ad assets; preserve videoplayback and dclk_video_ads requests.
^https?://[\w-]+\.googlevideo\.com/(?!(?:dclk_video_ads|videoplayback\?)).+&oad(?:[=&]|$) _ reject-200

[Script]
youtube.clean.response = type=http-response,pattern=^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:[?#]|$),requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/XuanXiang007/shadowrocket-config/9e6ead9cf15b0677344711461a78fee1906701e6/scripts/youtube-response.js,argument="{"captionLang":"{{{字幕翻译语言}}}","blockUpload":{{{屏蔽上传按钮}}},"blockImmersive":{{{屏蔽选段按钮}}},"blockShorts":{{{屏蔽Shorts按钮}}},"debug":{{{启用调试模式}}}}"

[MITM]
hostname = %APPEND% -redirector*.googlevideo.com, *.googlevideo.com, s.youtube.com, www.youtube.com, youtubei.googleapis.com
