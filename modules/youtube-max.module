#!name=YouTube Max
#!desc=YouTube 去广告 + 后台播放
#!author=Maasea (core script) / Community ad rules
#!homepage=https://github.com/XuanXiang007/shadowrocket-config
#!version=2026.11.18.1
#
# Only requested features: ad blocking and background audio.
# No subtitles translation, UI-button hiding, Shorts hiding, third-party UMP Worker,
# or other optional features.
# Core: Maasea/sgmodule @ 65075cdb388fc5e3094afd7e7314c67b243f3525 (Apache-2.0)
# https://github.com/Maasea/sgmodule
# NOTE: The upstream script also enables PiP (picture-in-picture) internally.
# It has no independent PiP disable option. A truly PiP-free variant would need
# a separate customized response script; no extra script files are added here.
#
# Do not enable together with modules/youtube-enhance.module.
# HTTPS decryption + trusted Shadowrocket CA required.
# If player/ad_break blocking causes buffering, disable this module.

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT
DOMAIN,youtube-ads.l.google.com,REJECT

[URL Rewrite]
# In-video mid-roll ads.
^https?://(?:youtubei\.googleapis\.com|(?:www|m)\.youtube\.com)/youtubei/v\d+/player/ad_break(?:[?#]|$) _ reject-200
# Ad endpoints and telemetry.
^https?://(?:www|m|s)\.youtube\.com/api/stats/ads(?:[/?#]|$) _ reject-200
^https?://(?:www|m|s)\.youtube\.com/(?:pagead|ptracking)(?:[/?#]|$) _ reject-200
^https?://(?:www|m|s)\.youtube\.com/pcs/activeview(?:[/?#]|$) _ reject-200
^https?://s\.youtube\.com/api/stats/qoe\?adcontext(?:[=&]|$) _ reject-200
# Preserve normal videoplayback/initplayback requests.
^https?://[\w-]+\.googlevideo\.com/dclk_video_ads(?:[/?#]|$) _ reject-200
^https?://[\w-]+\.googlevideo\.com/(?!(?:dclk_video_ads|videoplayback\?|initplayback\?)).+&oad(?:[=&]|$) _ reject-200

[Script]
# Response processor: remove ads, enable background playback.
# Explicitly turn off unrelated built-in cosmetic/translation features.
youtube.max.response = type=http-response,pattern=^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch|log_event|config)(?:[?#]|$),requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/65075cdb388fc5e3094afd7e7314c67b243f3525/Script/Youtube/youtube.response.js,argument="{"captionLang":"off","blockUpload":false,"blockImmersive":false,"blockShorts":false,"debug":false}"

[MITM]
hostname = %APPEND% -redirector*.googlevideo.com, *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, m.youtube.com, s.youtube.com
